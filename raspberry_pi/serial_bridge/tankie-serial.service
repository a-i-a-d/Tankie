# Tankie serial bridge daemon — issue #29, #53.
#
# Holds the control-link serial port (default /dev/ttyS0, Pi native UART0)
# and provides the NDJSON control link to the ESP8266.
#
# Installed system-wide (location-independent, issue #53):
#   daemon  -> /usr/local/lib/tankie/bridge.py
#   config  -> /etc/tankie/serial_bridge.yaml
#   CLI     -> /usr/local/bin/tankie-serial
#
#   systemctl enable --now tankie-serial
#   systemctl status tankie-serial
#   journalctl -u tankie-serial -f
[Unit]
Description=Tankie serial bridge (NDJSON control link to ESP8266)
Documentation=https://github.com/a-i-a-d/Tankie/issues/29
After=network.target
# The CH340 USB-serial device must be present before we open it.
After=systemd-udev-settled.service
Wants=systemd-udev-settled.service

[Service]
Type=simple
# Run as the pi user (dialout group gives access to /dev/ttyS0).
User=pi
Group=pi
SupplementaryGroups=dialout
# /var/lib/tankie is where the state file lives.
WorkingDirectory=/var/lib/tankie
ExecStart=/usr/bin/python3 /usr/local/lib/tankie/bridge.py --config /etc/tankie/serial_bridge.yaml
Restart=always
RestartSec=2
# Safety: if the daemon dies, the ESP8266 watchdog stops the motors within
# SERIAL_WATCHDOG_MS (1000 ms) — no keep-alive means the tank stops.
TimeoutStopSec=5
KillMode=mixed

# Hardening (best-effort on a Pi Zero)
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
